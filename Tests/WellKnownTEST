well_known_words = set(words.words())

setofwords = ["This", "is", "a", "sample", "text", "with", "some", "words,", "easy", "and", "difficult!"]

def get_well_known_words(setofwords, well_known_words):
    return [word for word in setofwords if word.lower() in well_known_words]

well_known = get_well_known_words(setofwords, well_known_words)

print("well known words:", well_known)